@model IReadOnlyList<_DOTNET____First_vs_Single.Models.Product>

@{
    ViewData["Title"] = "Catálogo de productos";
    var categories = (IEnumerable<string>)ViewBag.Categories;
}

<div class="mb-4">
    <h1 class="display-6">Catálogo de productos</h1>
    <p class="lead">Demo de LINQ: busca productos y compara <code>First()</code> con <code>Single()</code>.</p>
</div>

<form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-5">
        <label for="name" class="form-label">Nombre</label>
        <input id="name" name="name" value="@ViewBag.NameFilter" class="form-control" placeholder="Ej.: café" />
    </div>
    <div class="col-md-4">
        <label for="category" class="form-label">Categoría</label>
        <select id="category" name="category" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var category in categories)
            {
                <option value="@category" selected="@(string.Equals(category, (string?)ViewBag.CategoryFilter, StringComparison.OrdinalIgnoreCase))">@category</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="text-muted">@Model.Count producto(s) encontrado(s).</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">No se encontraron productos con esos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td><span class="badge text-bg-light">@product.Category</span></td>
                        <td class="text-end">@product.Price.ToString("C")</td>
                        <td class="text-end">
                            <a asp-action="DetailsFirst" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Detalle con First()</a>
                            <a asp-action="DetailsSingle" asp-route-id="@product.Id" class="btn btn-sm btn-outline-success">Detalle con Single()</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
